# The bearer token sits in localStorage, so injected script must not run.
# connect-src is https: rather than one origin: the server URL is a setting.
# blob: carries the favicons, fetched with the token and handed to <img>.
/*
  Content-Security-Policy: default-src 'self'; connect-src 'self' https:; img-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'

# Vite content-hashes everything under /assets.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Browsers check for a new worker on navigation; don't let a cache hide it.
/sw.js
  Cache-Control: no-cache
